# Copy to .env.local and fill in. Every value here is a PLACEHOLDER, never a
# real credential. Production values live in the Vercel project env vars under
# the same names.
#
# Only NEXT_PUBLIC_ variables reach the browser. Everything else is read on the
# server and must never gain that prefix.

# --- Analytics -------------------------------------------------------------
# PostHog project API key, EU region. The phc_ prefix is the write-only
# ingestion key and is public by design, which is why it may carry the prefix.
# PostHog > Settings > Project > API key.
NEXT_PUBLIC_POSTHOG_KEY=phc_replace_with_your_project_api_key
# Optional. Defaults to https://eu.posthog.com in code.
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com

# --- Site ------------------------------------------------------------------
# Used to build absolute links in emails. Without it they fall back to the
# request origin, which is wrong in an email since there is no request.
NEXT_PUBLIC_SITE_URL=https://dirckmulder.com

# --- Email, Resend ---------------------------------------------------------
# Server-side key. Never prefix with NEXT_PUBLIC_.
# Read by the subscribe route, the confirm route's welcome email and the
# contact form. Without it those log a skip and carry on rather than failing.
RESEND_API_KEY=re_replace_with_your_resend_api_key

# Signing secret for the Resend webhook, from the endpoint in the Resend
# dashboard. The webhook is public, so this signature is the only thing between
# it and anyone who knows the URL.
RESEND_WEBHOOK_SECRET=whsec_replace_with_your_webhook_signing_secret

# Newsletter sender and reply-to. Both default to dirck@dirckmulder.com in code.
NEWSLETTER_FROM_EMAIL=news@mail.dirckmulder.com
NEWSLETTER_REPLY_TO=dirck@dirckmulder.com

# Contact form. Same defaults apply.
CONTACT_FROM_EMAIL=contact@dirckmulder.com
CONTACT_TO_EMAIL=replace_with_the_inbox_you_read

# --- Database, Supabase PostgREST ------------------------------------------
# The subscribers table lives in the `portfolio` schema, not `public`.
# The service key bypasses row level security, so it is server-only, always.
# src/lib/db.ts also accepts PROJECT_HUB_* and SUPABASE_* variants of these two,
# because the hub grew naming variants over time. Prefer the names below.
PORTFOLIO_SUPABASE_URL=https://replace_with_your_project.supabase.co
PORTFOLIO_SUPABASE_SERVICE_KEY=replace_with_your_service_role_key

# --- Privacy ---------------------------------------------------------------
# Salt for hashing subscriber IPs. Any long random string. Changing it makes
# previously stored hashes unmatchable, which is the intended property: the raw
# IP is never stored and must not be recoverable.
SUBSCRIBER_HASH_SALT=replace_with_a_long_random_string
